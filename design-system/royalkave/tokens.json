{
  "$meta": {
    "brand": "The Royal Kave",
    "tagline": "STHLM Artistry",
    "founded": 2008,
    "description": "Designtokens för The Royal Kave. Heraldiskt, strikt monokromt, skarpt. Se ROYALKAVE-DESIGN-SYSTEM.md.",
    "version": "1.0",
    "updatedAt": "2026-08-18"
  },

  "color": {
    "ink": "#111111",
    "void": "#0d0d0d",
    "soot": "#1e1e1e",
    "graphite": "#555555",
    "ash": "#8a8a8a",
    "smoke": "#d4d4d4",
    "bone": "#f2f2f2",
    "paper": "#ffffff",
    "gilt": "#b08d57"
  },

  "semantic": {
    "bg": "#ffffff",
    "bgAlt": "#f2f2f2",
    "bgDark": "#0d0d0d",
    "surfaceDark": "#1e1e1e",
    "text": "#111111",
    "textLight": "#ffffff",
    "textMuted": "#555555",
    "textDisabled": "#8a8a8a",
    "border": "#d4d4d4",
    "borderDark": "rgba(255,255,255,0.14)",
    "accent": "#111111",
    "accentText": "#ffffff",
    "badgeBg": "#111111",
    "badgeText": "#ffffff",
    "ctaBg": "#111111",
    "ctaText": "#ffffff"
  },

  "font": {
    "display": "'Playfair Display', 'Didot', 'Bodoni MT', Georgia, serif",
    "body": "'Inter', 'Helvetica Neue', Arial, sans-serif",
    "googleFonts": "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600&display=swap"
  },

  "type": {
    "headingTransform": "uppercase",
    "headingWeight": 900,
    "headingTracking": "0.04em",
    "labelTracking": "0.18em",
    "bodyLineHeight": 1.6,
    "scale": {
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 20,
      "xl": 25,
      "2xl": 33,
      "3xl": 44,
      "4xl": 59,
      "5xl": 79
    }
  },

  "space": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128],

  "radius": {
    "none": 0,
    "pill": 999
  },

  "motion": {
    "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)",
    "fast": 160,
    "base": 320,
    "slow": 640,
    "cinematic": 1200
  },

  "gradient": {
    "hero": "linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.2) 55%, transparent 100%)",
    "card": "linear-gradient(135deg, rgba(0,0,0,0.92) 0%, rgba(30,30,30,0.75) 100%)",
    "videoPlate": "rgba(0,0,0,0.35)"
  },

  "logo": {
    "marks": ["seal", "wordmark", "crest"],
    "variants": ["black", "white"],
    "path": "logos/dist",
    "clearSpace": "höjden på K i den använda logotypen",
    "minWidthPx": { "seal": 32, "wordmark": 160, "crest": 240 },
    "minWidthPrintMm": { "seal": 12, "wordmark": 45, "crest": 60 },
    "minWidthVideoPx1080": { "seal": 96, "wordmark": 320, "crest": 480 }
  },

  "video": {
    "watermarkOpacity": 0.55,
    "watermarkScaleOfShortSide": 0.06,
    "watermarkMarginPx1080": 48,
    "endcardBg": "#0d0d0d",
    "endcardCrestWidthRatio": 0.62,
    "endcardDurationMs": 2000,
    "lowerThirdHoldMs": 3500,
    "fadeToBlackMs": 400,
    "loudnessLufs": -14,
    "formats": {
      "reel": { "w": 1080, "h": 1920, "fps": 30, "safeTop": 120, "safeBottom": 420 },
      "square": { "w": 1080, "h": 1080, "fps": 30, "safe": 80 },
      "story": { "w": 1080, "h": 1920, "fps": 30, "safeTop": 250, "safeBottom": 250 },
      "landscape": { "w": 1920, "h": 1080, "fps": 25, "safe": 90 },
      "master4k": { "w": 3840, "h": 2160, "fps": 25, "safe": 180 }
    }
  },

  "legacy": {
    "$note": "Vad som ligger i prod idag i studioRegistry.royalkave. Byts ut vid nästa uppdatering av studiosidan.",
    "fontHeading": "'Barlow Condensed', 'Arial Narrow', Arial, sans-serif",
    "googleFonts": "https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;900&family=Inter:wght@400;500&display=swap",
    "source": "inkrevenue/frontend/src/pages/studios/index.js"
  }
}
