# Server port. Railway sets this automatically in production.
PORT=5000

# Allowed frontend origin(s) for CORS.
# Use a comma-separated list if you need multiple domains.
FRONTEND_URL=http://localhost:5174

# Public base URL to the tattoo-crm backend that inkrevenue forwards API calls to.
CRM_API_BASE_URL=http://localhost:4000

# Optional rate limit tuning for public form submissions.
SUBMISSION_RATE_LIMIT_WINDOW_MS=900000
SUBMISSION_RATE_LIMIT_MAX=6

# Optional rate limit tuning for draft saves.
DRAFT_SAVE_RATE_LIMIT_WINDOW_MS=900000
DRAFT_SAVE_RATE_LIMIT_MAX=40

# Optional rate limit tuning for public read endpoints.
PUBLIC_READ_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_READ_RATE_LIMIT_MAX=20

# Optional rate limit tuning for the booking preview. Own bucket on purpose:
# the form calls it after every pause in the description field, so it does not
# fit inside the 20/min the other public read endpoints share.
BOOKING_PREVIEW_RATE_LIMIT_WINDOW_MS=60000
BOOKING_PREVIEW_RATE_LIMIT_MAX=40

# ── Who is the client? (rate limits are keyed on this) ───────────────────────
# Number of proxies IN FRONT of this app that are ours. The client address is
# read as the Nth value from the RIGHT in x-forwarded-for — values further left
# may have been sent by the client itself. 1 = the platform edge only.
TRUSTED_PROXY_HOPS=1
# Shared secret with the tattoo-crm backend. Set the SAME value in both
# services and the proxy sends the visitor IP in x-client-ip, which the CRM
# then trusts. Leave empty and the CRM falls back to x-forwarded-for.
INTERNAL_PROXY_SECRET=
